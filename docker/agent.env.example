# Copy this file to docker/agent.env and adjust the values.
# docker/agent.env is intentionally not committed because it can contain tokens.

AI_TEAMS_AUTH_TOKEN=dev-token

# Required when the server runs with AGENT_REGISTRATION_MODE=approval.
# Create or approve the Agent in Web -> 员工管理, then paste its token here.
AI_TEAMS_AGENT_TOKEN=

# When the server runs on the host machine, Docker Desktop can reach it here.
SERVER_URL=ws://host.docker.internal:3789

EMPLOYEE_ID=alice
EMPLOYEE_NAME=Alice
EMPLOYEE_LABELS=docker,sandbox

# claude = real Claude Code CLI, fake = local test runner.
RUNNER_MODE=claude

# bypassPermissions runs without Claude Code confirmation prompts.
# Use default for stricter manual confirmations.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Host path mounted into the container as /workspace.
AI_TEAMS_AGENT_WORKSPACE=./sandbox/agent-alice

# Set false if you want to install Claude Code manually in a derived image.
INSTALL_CLAUDE_CODE=true
